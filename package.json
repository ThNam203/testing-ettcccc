{
  "name": "english-derby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Live interactive English quiz horse race (local prototype, TikTok integration later)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "tiktok": "node --disable-warning=ExperimentalWarning scripts/derby-server.mjs --tiktok",
    "server": "node --disable-warning=ExperimentalWarning scripts/derby-server.mjs"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.1.0",
    "tiktok-live-connector": "2.5.0",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
